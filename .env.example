# LLM Provider Configuration
# Supported options: mock, openai, groq, gemini, ollama
LLM_PROVIDER=mock

# OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Groq API Key (if LLM_PROVIDER=groq)
GROQ_API_KEY=

# Google Gemini API Key (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Local Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
